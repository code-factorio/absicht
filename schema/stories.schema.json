{
  "$defs": {
    "Confidence": {
      "description": "How much we trust this, independent of how complete it is.",
      "enum": [
        "assumed",
        "reviewed",
        "verified"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Criterion": {
      "additionalProperties": false,
      "description": "Acceptance criterion. Behavioural ones serialize to a scenario.\n\n`id` is stable and survives rewording, so step definitions written against\nit are not orphaned when the story text changes.",
      "properties": {
        "id": {
          "pattern": "^[a-z]+:[a-z0-9][a-z0-9-]*#ac-\\d+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CriterionKind",
          "default": "behavioural"
        },
        "given": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Given",
          "type": "array"
        },
        "when": {
          "default": "",
          "title": "When",
          "type": "string"
        },
        "then": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Then",
          "type": "array"
        },
        "statement": {
          "default": "",
          "title": "Statement",
          "type": "string"
        },
        "touches": {
          "default": [],
          "items": {
            "pattern": "^[a-z]+:[a-z0-9][a-z0-9-]*$",
            "type": "string"
          },
          "title": "Touches",
          "type": "array"
        }
      },
      "required": [
        "id"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "CriterionKind": {
      "enum": [
        "behavioural",
        "structural",
        "measured"
      ],
      "title": "CriterionKind",
      "type": "string"
    },
    "State": {
      "description": "How complete an element is, and what an agent may do about it.",
      "enum": [
        "specified",
        "constrained",
        "delegated",
        "unknown",
        "observed",
        "out_of_scope"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z]+:[a-z0-9][a-z0-9-]*$",
      "title": "Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/State",
      "default": "unknown"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence",
      "default": "assumed"
    },
    "owner": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner"
    },
    "tags": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "source": {
      "default": "",
      "description": "Path within the store. Written by the loader.",
      "title": "Source",
      "type": "string"
    },
    "body": {
      "default": "",
      "description": "Prose, verbatim. Never parsed.",
      "title": "Body",
      "type": "string"
    },
    "actor": {
      "default": "",
      "title": "Actor",
      "type": "string"
    },
    "outcome": {
      "default": "",
      "title": "Outcome",
      "type": "string"
    },
    "satisfies": {
      "default": [],
      "items": {
        "pattern": "^[a-z]+:[a-z0-9][a-z0-9-]*$",
        "type": "string"
      },
      "title": "Satisfies",
      "type": "array"
    },
    "acceptance": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Criterion"
      },
      "title": "Acceptance",
      "type": "array"
    }
  },
  "required": [
    "id",
    "title"
  ],
  "title": "Story",
  "type": "object"
}
