{
  "$defs": {
    "Confidence": {
      "description": "How much we trust this, independent of how complete it is.",
      "enum": [
        "assumed",
        "reviewed",
        "verified"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "State": {
      "description": "How complete an element is, and what an agent may do about it.",
      "enum": [
        "specified",
        "constrained",
        "delegated",
        "unknown",
        "observed",
        "out_of_scope"
      ],
      "title": "State",
      "type": "string"
    },
    "Unit": {
      "additionalProperties": false,
      "description": "A design unit this system composes. Its own release cadence.",
      "properties": {
        "id": {
          "pattern": "^[a-z]+:[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "design": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Design"
        },
        "repo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repo"
        },
        "ref": {
          "default": "main",
          "description": "A ref, never a pin. Pinning belongs to a deliberate upgrade.",
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "Unit",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z]+:[a-z0-9][a-z0-9-]*$",
      "title": "Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/State",
      "default": "unknown"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence",
      "default": "assumed"
    },
    "owner": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner"
    },
    "tags": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "source": {
      "default": "",
      "description": "Path within the store. Written by the loader.",
      "title": "Source",
      "type": "string"
    },
    "body": {
      "default": "",
      "description": "Prose, verbatim. Never parsed.",
      "title": "Body",
      "type": "string"
    },
    "purpose": {
      "default": "",
      "title": "Purpose",
      "type": "string"
    },
    "units": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Unit"
      },
      "title": "Units",
      "type": "array"
    },
    "externals": {
      "default": [],
      "items": {
        "pattern": "^[a-z]+:[a-z0-9][a-z0-9-]*$",
        "type": "string"
      },
      "title": "Externals",
      "type": "array"
    }
  },
  "required": [
    "id",
    "title"
  ],
  "title": "System",
  "type": "object"
}
