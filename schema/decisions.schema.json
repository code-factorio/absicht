{
  "$defs": {
    "Confidence": {
      "description": "How much we trust this, independent of how complete it is.",
      "enum": [
        "assumed",
        "reviewed",
        "verified"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "DecisionStatus": {
      "enum": [
        "proposed",
        "accepted",
        "superseded"
      ],
      "title": "DecisionStatus",
      "type": "string"
    },
    "Reversibility": {
      "description": "Cost of being wrong. The delegation axis that actually matters.",
      "enum": [
        "cheap",
        "costly",
        "one_way"
      ],
      "title": "Reversibility",
      "type": "string"
    },
    "State": {
      "description": "How complete an element is, and what an agent may do about it.",
      "enum": [
        "specified",
        "constrained",
        "delegated",
        "unknown",
        "observed",
        "out_of_scope"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "ADR. Context and consequences live in `body` — the argument is the point.",
  "properties": {
    "id": {
      "pattern": "^[a-z]+:[a-z0-9][a-z0-9-]*$",
      "title": "Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/State",
      "default": "unknown"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence",
      "default": "assumed"
    },
    "owner": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner"
    },
    "tags": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "source": {
      "default": "",
      "description": "Path within the store. Written by the loader.",
      "title": "Source",
      "type": "string"
    },
    "body": {
      "default": "",
      "description": "Prose, verbatim. Never parsed.",
      "title": "Body",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/DecisionStatus",
      "default": "proposed"
    },
    "decided_on": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decided On"
    },
    "reversibility": {
      "$ref": "#/$defs/Reversibility",
      "default": "cheap"
    },
    "applies_to": {
      "default": [],
      "items": {
        "pattern": "^[a-z]+:[a-z0-9][a-z0-9-]*$",
        "type": "string"
      },
      "title": "Applies To",
      "type": "array"
    },
    "supersedes": {
      "default": [],
      "items": {
        "pattern": "^[a-z]+:[a-z0-9][a-z0-9-]*$",
        "type": "string"
      },
      "title": "Supersedes",
      "type": "array"
    }
  },
  "required": [
    "id",
    "title"
  ],
  "title": "Decision",
  "type": "object"
}
