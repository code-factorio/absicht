{
  "$defs": {
    "Confidence": {
      "description": "How much we trust this, independent of how complete it is.",
      "enum": [
        "assumed",
        "reviewed",
        "verified"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "SeamStyle": {
      "enum": [
        "call",
        "http",
        "event",
        "queue",
        "schema"
      ],
      "title": "SeamStyle",
      "type": "string"
    },
    "State": {
      "description": "How complete an element is, and what an agent may do about it.",
      "enum": [
        "specified",
        "constrained",
        "delegated",
        "unknown",
        "observed",
        "out_of_scope"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A boundary. The provider owns the contract; consumers own expectations.",
  "properties": {
    "id": {
      "pattern": "^[a-z]+:[a-z0-9][a-z0-9-]*$",
      "title": "Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/State",
      "default": "unknown"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence",
      "default": "assumed"
    },
    "owner": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner"
    },
    "tags": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "source": {
      "default": "",
      "description": "Path within the store. Written by the loader.",
      "title": "Source",
      "type": "string"
    },
    "body": {
      "default": "",
      "description": "Prose, verbatim. Never parsed.",
      "title": "Body",
      "type": "string"
    },
    "style": {
      "$ref": "#/$defs/SeamStyle"
    },
    "provider": {
      "anyOf": [
        {
          "pattern": "^[a-z]+:[a-z0-9][a-z0-9-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider"
    },
    "consumers": {
      "default": [],
      "items": {
        "pattern": "^[a-z]+:[a-z0-9][a-z0-9-]*$",
        "type": "string"
      },
      "title": "Consumers",
      "type": "array"
    },
    "contract": {
      "default": "",
      "title": "Contract",
      "type": "string"
    },
    "carries": {
      "default": [],
      "items": {
        "pattern": "^[a-z]+:[a-z0-9][a-z0-9-]*$",
        "type": "string"
      },
      "title": "Carries",
      "type": "array"
    },
    "failure_modes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Failure Modes",
      "type": "array"
    },
    "verified_by": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Verified By",
      "type": "array"
    }
  },
  "required": [
    "id",
    "title",
    "style"
  ],
  "title": "Seam",
  "type": "object"
}
