{
  "$defs": {
    "Watermark": {
      "additionalProperties": false,
      "description": "How far one component's code in this repository has come.",
      "properties": {
        "id": {
          "description": "The component. `Design.repositories` says which repository this is.",
          "pattern": "^[a-z]+:[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "path": {
          "default": ".",
          "description": "Where inside the repository, matching the component's `implemented_by`.",
          "title": "Path",
          "type": "string"
        },
        "at": {
          "anyOf": [
            {
              "pattern": "^[a-z]+:[a-z0-9][a-z0-9-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The last milestone landed here.",
          "title": "At"
        },
        "design_rev": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The design store's head when it landed.",
          "title": "Design Rev"
        }
      },
      "required": [
        "id"
      ],
      "title": "Watermark",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The `.absicht` file itself.",
  "properties": {
    "design": {
      "description": "Path or URL of the store. Spelled by whoever wrote the marker.",
      "title": "Design",
      "type": "string"
    },
    "units": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Watermark"
      },
      "title": "Units",
      "type": "array"
    }
  },
  "required": [
    "design"
  ],
  "title": "Marker",
  "type": "object"
}
