{
  "$defs": {
    "UnitWatermark": {
      "additionalProperties": false,
      "description": "From a repo's `.absicht` marker. A hint, not a proof.\n\nTends to over-claim: a merge stamps it whether or not the work was finished.",
      "properties": {
        "id": {
          "pattern": "^[a-z]+:[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "path": {
          "default": ".",
          "title": "Path",
          "type": "string"
        },
        "at": {
          "anyOf": [
            {
              "pattern": "^[a-z]+:[a-z0-9][a-z0-9-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At"
        },
        "design_rev": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Design Rev"
        }
      },
      "required": [
        "id"
      ],
      "title": "UnitWatermark",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A repo's `.absicht` file. Discovery hint; the store stays authoritative.",
  "properties": {
    "design": {
      "title": "Design",
      "type": "string"
    },
    "units": {
      "default": [],
      "items": {
        "$ref": "#/$defs/UnitWatermark"
      },
      "title": "Units",
      "type": "array"
    }
  },
  "required": [
    "design"
  ],
  "title": "Marker",
  "type": "object"
}
